# SGEDA 环境变量配置
# 复制为 .env 并填入真实值

# DeepSeek API Key（必填）
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# AI 模型（可选，默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# 顾问微信号（可选）
WECHAT_ID=你的微信号

# 顾问微信二维码图片 URL（可选）
WECHAT_QR_URL=https://www.sgeda.org.cn/assets/wechat-qr.jpg

# API 服务端口（默认 3001）
PORT=3001

# 日报 API Token（用于 /api/analytics/report?token=xxx）
ANALYTICS_REPORT_TOKEN=seda-report-2026
