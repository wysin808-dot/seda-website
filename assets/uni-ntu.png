}</style><style type="text/css" media="all">.ntu-profile-list {
  font-family: "Lato", Arial, sans-serif;
}

.ntu-profile-list .icon {
  margin-right: 10px;
}

.ntu-profile-list .profile-list {
  display: flex;
  flex-direction: column;
}

.ntu-profile-list .profile-row {
  display: flex;
  gap: 28px;
  align-items: flex-start;
  padding: 20px 0;
  background: transparent;
  border: 0;
  border-bottom: 1px solid #e0e0e0;
  border-radius: 0;
  box-shadow: none;
  transition: none;
}

.ntu-profile-list .profile-row:hover {
  transform: none;
  box-shadow: none;
}

.ntu-profile-list .profile-row-image-wrap {
  width: 120px;
  min-width: 120px;
}

/* IMAGE */
.ntu-profile-list .profile-row-image-wrap img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: cover;
  border-radius: 14px;
  background: #fff;
}

/* SILENT PLACEHOLDER (no text, no border) */
.ntu-profile-list .profile-row-image-wrap:empty::after {
  content: "";
  display: block;
  width: 100%;
  height: 140px; /* smaller so it doesn't dominate */
  background: transparent;
  border-radius: 14px;
}

.ntu-profile-list .profile-row-content {
  flex: 1;
  padding-top: 4px;
}

.ntu-profile-list .profile-row-name {
  margin: 0 0 10px;
  font-size: 1.125em !important;
  font-weight: 700;
  line-height: 1;
}

.ntu-profile-list .profile-row-name a {
  text-decoration: none;
}

.ntu-profile-list .profile-row-name a:hover {
  text-decoration: underline;
}

.ntu-profile-list .profile-row-designation {
  font-size: 16px;
  line-height: 1.25;
  color: #222;
  margin-bottom: 10px;
}

.ntu-profile-list .profile-row-org {
  font-size: 14px;
  line-height: 1.5;
  color: #333;
}

.ntu-profile-list .profile-row-org a {
  color: #d71440;
  text-decoration: none;
}

.ntu-profile-list .profile-row-org a:hover .text,
.ntu-profile-list .profile-row-org a .text:hover {
  text-decoration: underline;
}

/* CARD GRID */
.ntu-profile-list .profile-card-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24px;
  align-items: stretch;
}

.ntu-profile-list .profile-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
}

.ntu-profile-list .profile-card-image-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 215px;
  padding: 15px;
  background: #fff;
}

/* CARD IMAGE */
.ntu-profile-list .profile-card-image-wrap img {
  display: block;
  max-width: 100%;
  width: auto;
  max-height: 180px;
  object-fit: contain;
  border-radius: 10px;
  background: #fff;
}

/* SILENT CARD PLACEHOLDER */
.ntu-profile-list .profile-card-image-wrap:empty::after {
  content: "";
  display: block;
  width: 100%;
  height: 160px;
  background: transparent;
  border-radius: 10px;
}

.ntu-profile-list .profile-card-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6px;
  padding: 16px 18px 18px;
}

.ntu-profile-list .profile-card-name {
  min-height: 1.2em;
  margin: 0;
  font-size: 17px !important;
  font-weight: 700;
  line-height: 1;
}

.ntu-profile-list .profile-card-name a {
  color: #d71440;
  text-decoration: none;
}

.ntu-profile-list .profile-card-name a:hover {
  text-decoration: underline;
}

.ntu-profile-list .profile-card-designation {
  font-size: 14px;
  line-height: 1.5;
  color: #333;
}

.ntu-profile-list .profile-card-org {
  font-size: 14px;
  line-height: 1.5;
  color: #444;
}

.ntu-profile-list .profile-card-org a {
  color: #d71440;
  font-weight: 500;
  text-decoration: none;
}

.ntu-profile-list .profile-card-org a:hover .text,
.ntu-profile-list .profile-card-org a .text:hover {
  text-decoration: underline;
}

/* RESPONSIVE */
@media (max-width: 1024px) {
  .ntu-profile-list .profile-card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 768px) {
  .ntu-profile-list .profile-row {
    flex-direction: column;
    padding: 20px 0 26px;
  }

  .ntu-profile-list .profile-row-image-wrap {
    width: 160px;
    min-width: 160px;
  }

  .ntu-profile-list .profile-row-name {
    font-size: 20px !important;
  }

  .ntu-profile-list .profile-card-grid {
    grid-template-columns: 1fr;
  }
}</style><link rel="canonical" href="https://www.ntu.edu.sg/404" /><meta property="og:image" content="https://www.ntu.edu.sg/images/default-source/default-album/ntu-thehive-775x465.jpg" /></head> <body> <!-- Google Tag Manager (noscript) --> <noscript> <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WHB582W"
